# JEV Browser Agent Environment Variables
# Copy this file to .env and adjust as needed

# JEV Configuration
# Set to 'mock' for local evaluation and testing without API credentials
# Set to 'real' to call live JEV System-One Decision API
JEV_MODE=mock
JEV_API_KEY=
JEV_API_URL=https://api.jev.ai/v1
JEV_MODEL=system-one-v1

# Fallback LLM Configuration
# Providers: mock, openai-compatible, gemini
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Confidence Routing Thresholds
# >= AUTO_EXECUTE_THRESHOLD executes immediately
AUTO_EXECUTE_THRESHOLD=0.90
# >= LOW_RISK_THRESHOLD executes if LOW risk; otherwise asks confirmation
LOW_RISK_THRESHOLD=0.70

# Agent Execution Settings
MAX_STEPS=30
HEADLESS=true
ACTION_DELAY_MS=500
BROWSER_TIMEOUT_MS=30000

# Server Settings
HOST=0.0.0.0
PORT=8000
DB_PATH=data/jev_agent.db
